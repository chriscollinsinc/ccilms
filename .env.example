# --- TalentLMS ---
# Your TalentLMS subdomain, e.g. "chriscollins" for chriscollins.talentlms.com
TALENTLMS_DOMAIN=yourdomain
# Super-admin API key (Account & Settings -> Basic settings -> API). NEVER expose client-side.
TALENTLMS_API_KEY=your_api_key_here

# --- Portal ---
# Random 32+ char string used to sign session cookies. Generate: openssl rand -base64 32
SESSION_SECRET=change_me_to_a_long_random_string
# Public URL of THIS portal (used for logout/completion redirects back from TalentLMS)
PORTAL_URL=http://localhost:3000

# Set to "true" to run the full flow with fake data and no TalentLMS account.
# In mock mode any login works (try demo / demo).
TALENTLMS_MOCK=false

# --- YouTube (podcast playlist sync) ---
# Google Cloud Console -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=
